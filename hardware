#include <SoftwareSerial.h>

// Define Bluetooth Module (HC-05) on Pins 11 (RX), 12 (TX)
SoftwareSerial mySerial(11, 12);

// Define Metal Sensor Pin
#define METAL_SENSOR 2

// Define Motor Pins (L293D Motor Driver 1) - Front Motors
#define RIGHT_M1_IN1 3  // Right Front Motor
#define RIGHT_M1_IN2 4
#define LEFT_M1_IN1 5   // Left Front Motor
#define LEFT_M1_IN2 6

// Define Motor Pins (L293D Motor Driver 2) - Rear Motors
#define RIGHT_M2_IN1 7  // Right Rear Motor
#define RIGHT_M2_IN2 8
#define LEFT_M2_IN1 9   // Left Rear Motor
#define LEFT_M2_IN2 10

// Base GPS Coordinates (Modify as needed)
#define BASE_LAT 78.0559657
#define BASE_LON 15.7733506

char command;

void setup() {
    Serial.begin(9600);      // PC Serial Monitor
    mySerial.begin(9600);    // HC-05 Bluetooth Module

    // Set Motor Pins as Output
    pinMode(RIGHT_M1_IN1, OUTPUT);
    pinMode(RIGHT_M1_IN2, OUTPUT);
    pinMode(LEFT_M1_IN1, OUTPUT);
    pinMode(LEFT_M1_IN2, OUTPUT);
    pinMode(RIGHT_M2_IN1, OUTPUT);
    pinMode(RIGHT_M2_IN2, OUTPUT);
    pinMode(LEFT_M2_IN1, OUTPUT);
    pinMode(LEFT_M2_IN2, OUTPUT);

    pinMode(METAL_SENSOR, INPUT);

    delay(1000); // Allow device to initialize

    Serial.println("Metal Detection Robot Ready");
    mySerial.println("Metal Detection Robot Ready");
}

void loop() {
    // Bluetooth Command Handling (F, B, L, R, S)
    if (mySerial.available()) {
        command = mySerial.read();
        Serial.print("Received Command: ");
        Serial.println(command);

        if (command == 'F') moveForward();
        if (command == 'B') moveBackward();
        if (command == 'L') turnLeft();
        if (command == 'R') turnRight();
        if (command == 'S') stopMotors();
    }

    // Metal Detection Logic
    if (digitalRead(METAL_SENSOR) == HIGH) {
        Serial.println("⚠ Metal Detected!");
        mySerial.println("⚠ Metal Detected!");

        // Stop the robot
        stopMotors();
        
        // Generate GPS coordinates
        float latitude = BASE_LAT + random(-500, 500) / 100000.0; // ±0.005 variation
        float longitude = BASE_LON + random(-500, 500) / 100000.0; // ±0.005 variation

        // Display GPS Coordinates on Serial Monitor & Bluetooth Terminal
        Serial.print("🚀 GPS Coordinates: Lat = "); Serial.print(latitude, 7);
        Serial.print(", Lon = "); Serial.println(longitude, 7);
        
        mySerial.print("🚀 GPS Coordinates: Lat = "); mySerial.print(latitude, 7);
        mySerial.print(", Lon = "); mySerial.println(longitude, 7);

        // Pause for 5 seconds
        delay(5000);

        Serial.println("Resuming Operations...");
        mySerial.println("Resuming Operations...");
    }

    // Short delay for stability
    delay(100);
}

// 🔹 Motor Control Functions
void moveForward() {
    digitalWrite(RIGHT_M1_IN1, HIGH);
    digitalWrite(RIGHT_M1_IN2, LOW);
    digitalWrite(LEFT_M1_IN1, HIGH);
    digitalWrite(LEFT_M1_IN2, LOW);
    digitalWrite(RIGHT_M2_IN1, HIGH);
    digitalWrite(RIGHT_M2_IN2, LOW);
    digitalWrite(LEFT_M2_IN1, HIGH);
    digitalWrite(LEFT_M2_IN2, LOW);
    Serial.println("Moving Forward");
    mySerial.println("Moving Forward");
}

void moveBackward() {
    digitalWrite(RIGHT_M1_IN1, LOW);
    digitalWrite(RIGHT_M1_IN2, HIGH);
    digitalWrite(LEFT_M1_IN1, LOW);
    digitalWrite(LEFT_M1_IN2, HIGH);
    digitalWrite(RIGHT_M2_IN1, LOW);
    digitalWrite(RIGHT_M2_IN2, HIGH);
    digitalWrite(LEFT_M2_IN1, LOW);
    digitalWrite(LEFT_M2_IN2, HIGH);
    Serial.println("Moving Backward");
    mySerial.println("Moving Backward");
}

void turnLeft() {
    digitalWrite(RIGHT_M1_IN1, HIGH);
    digitalWrite(RIGHT_M1_IN2, LOW);
    digitalWrite(LEFT_M1_IN1, LOW);
    digitalWrite(LEFT_M1_IN2, HIGH);
    digitalWrite(RIGHT_M2_IN1, HIGH);
    digitalWrite(RIGHT_M2_IN2, LOW);
    digitalWrite(LEFT_M2_IN1, LOW);
    digitalWrite(LEFT_M2_IN2, HIGH);
    Serial.println("Turning Left");
    mySerial.println("Turning Left");
}

void turnRight() {
    digitalWrite(RIGHT_M1_IN1, LOW);
    digitalWrite(RIGHT_M1_IN2, HIGH);
    digitalWrite(LEFT_M1_IN1, HIGH);
    digitalWrite(LEFT_M1_IN2, LOW);
    digitalWrite(RIGHT_M2_IN1, LOW);
    digitalWrite(RIGHT_M2_IN2, HIGH);
    digitalWrite(LEFT_M2_IN1, HIGH);
    digitalWrite(LEFT_M2_IN2, LOW);
    Serial.println("Turning Right");
    mySerial.println("Turning Right");
}

void stopMotors() {
    digitalWrite(RIGHT_M1_IN1, LOW);
    digitalWrite(RIGHT_M1_IN2, LOW);
    digitalWrite(LEFT_M1_IN1, LOW);
    digitalWrite(LEFT_M1_IN2, LOW);
    digitalWrite(RIGHT_M2_IN1, LOW);
    digitalWrite(RIGHT_M2_IN2, LOW);
    digitalWrite(LEFT_M2_IN1, LOW);
    digitalWrite(LEFT_M2_IN2, LOW);
    Serial.println("Motors Stopped");
    mySerial.println("Motors Stopped");
}
